# Copy the folder-specific examples before running locally:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#
# Production / App Runner: set PORT (App Runner provides this), NODE_ENV=production.
# Do not place secrets in VITE_ variables; they are bundled into the browser.

HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
AI_PROVIDER=mock
VITE_API_URL=/api
