# Local development (npm --prefix backend run dev)
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
AI_PROVIDER=mock
# Optional future keys. Leave blank for local mock mode.
# Never put secrets in frontend VITE_ variables.
OPENAI_API_KEY=
DATABASE_URL=
DATA_FILE=store.json
DEFAULT_USER_NAME=Alex Morgan

# Production / AWS App Runner uses process.env.PORT and binds 0.0.0.0.
# NODE_ENV=production also enables demo mode (generic profile, not local store.json).
# DEMO_MODE=true
